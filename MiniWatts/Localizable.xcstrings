    "Accessory battery via audio route" : {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频路由配件电量"
          }
        }
      }
    },
    "This is WattTrace's current audio route, not a list of connected Bluetooth devices. An AirPods name can appear here without access to its battery levels. No audio session is activated or changed by this check." : {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是 WattTrace 当前的音频路由，不是已连接蓝牙设备列表。即使能显示 AirPods 名称，也不代表能读取其电量。此检查不会激活或更改音频会话。"
          }
        }
      }
    },
    "Refresh audio route" : {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新音频路由"
          }
