          "stringUnit": {
            "state": "translated",
            "value": "热压力状态有效时长"
          }
        }
      }
    },
    "Legacy history records only whether high thermal pressure was present." : {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧版历史只记录是否存在高热压力。"
          }
        }
      }
    },
    "Device compatibility" : {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备兼容性"
          }
        }
      }
