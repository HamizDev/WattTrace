    "CSV and JSON files" : {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV 与 JSON 文件"
          }
        }
      }
    },
    "Saved curves, SOC bands and thermal analysis" : {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史曲线、SOC 分段与热分析"
          }
        }
      }
