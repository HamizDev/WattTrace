        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB-C"
          }
        }
      }
    },
    "USB-C input" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
