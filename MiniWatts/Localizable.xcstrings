    "Watch observations" : {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手表采样记录"
          }
        }
      }
    },
    "Up to 500 received observations are kept for the active paired watch. Gaps are not filled in, and Watch watts and energy are not estimated." : {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为当前配对手表最多保留 500 条已接收记录。不补齐采样空档，也不估算手表功率与能量。"
          }
        }
      }
    },
    "No Watch observations" : {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无手表采样记录"
          }
        }
      }
    },
    "Open WattTrace on the Watch to collect a reading." : {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在手表上打开 WattTrace 以获取电量读数。"
          }
        }
      }
    },
    "Export charging data" : {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出充电数据"
          }
        }
      }
