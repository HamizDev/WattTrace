    "Watch history is available only in memory because local storage is unavailable." : {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地存储不可用，手表历史暂时仅保存在内存中。"
          }
        }
      }
    },
    "Install and open WattTrace on the paired Apple Watch to send its battery level and charging state." : {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在已配对的 Apple Watch 上安装并打开 WattTrace，以发送电量和充电状态。"
          }
        }
      }
    },
    "Watch data is separate from iPhone charging sessions. Updates may be delayed; this is not continuous background monitoring." : {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手表数据与 iPhone 充电会话分开保存。更新可能延迟，并非持续后台监测。"
          }
        }
      }
    },
    "WatchConnectivity unavailable" : {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WatchConnectivity 不可用"
          }
